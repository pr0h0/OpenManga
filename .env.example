# Copy to .env and fill in. Never commit .env.
# Everything below the "Required" block has a working default — delete what you do not need.
# There are no server-level AI provider keys: each user adds their own in Account -> AI providers.

# --- Required ----------------------------------------------------------------
# Database password for the bundled postgres service.
POSTGRES_PASSWORD=change-me-long-random
# Signs session cookies. openssl rand -hex 32
SESSION_SECRET=change-me-at-least-32-characters-long
# Your public URLs (single domain is fine; nginx serves /app, /api and /cdn).
APP_PUBLIC_URL=https://comics.example.com/app
API_PUBLIC_URL=https://comics.example.com/api
CDN_PUBLIC_URL=https://comics.example.com/cdn
# Serve cookies over HTTPS only. Set to false for a plain-HTTP localhost test.
COOKIE_SECURE=true

# --- Everything below is optional --------------------------------------------

# --- Compose ---------------------------------------------------------------
# Profiles: tts = local Kokoro, mock = mock provider HTTP service, tunnel = cloudflared
COMPOSE_PROFILES=tts
NGINX_BIND=127.0.0.1
NGINX_PORT=3480
NODE_ENV=production
LOG_LEVEL=info
POSTGRES_USER=openmanga
POSTGRES_DB=openmanga

# Redis carries queue state and rate-limit keys, never provider keys or plaintext secrets, and is published to no
# host port — so it runs without a password by default. To require one, add `--requirepass` to the redis command in
# docker-compose.yml, set REDIS_URL here to redis://:<password>@redis:6379, and update its healthcheck.
# REDIS_URL=redis://redis:6379

# --- Provider key encryption -------------------------------------------------
# openssl rand -hex 32 — encrypts users' own provider API keys (BYOK). If empty it is derived from SESSION_SECRET,
# so rotating SESSION_SECRET would make saved keys unreadable. Back it up with the database.
CREDENTIALS_ENCRYPTION_KEY=
# Key rotation: put the new key in CREDENTIALS_ENCRYPTION_KEY and the previous one(s) here (comma-separated).
# Both decrypt during rotation; startup, the worker's maintenance run and Admin -> Rotate re-encrypt rows onto the new
# key. When Admin shows 0 pending, remove the old key.
CREDENTIALS_ENCRYPTION_OLD_KEYS=

# --- AI runs ------------------------------------------------------------------
# Applied to whichever provider a run picks.
AI_TEXT_TIMEOUT_MS=900000
AI_TEXT_MAX_CONCURRENCY=4
AI_IMAGE_TIMEOUT_MS=300000
AI_IMAGE_MAX_CONCURRENCY=8

# --- Image output -------------------------------------------------------------
IMAGE_QUALITY=low
# Output size menu; the nearest aspect to each panel wins (ties -> larger). Low quality bills 16:9/7:4/3:2 ~2 MP
# sizes at or below 1024x1024's cost; 1408x1408 costs ~30% more than 1024x1024 (measured 255 vs 196 output tokens).
IMAGE_SIZES=2048x1152,1152x2048,1792x1024,1024x1792,1536x1024,1024x1536,1408x1408
# Prompt-reference derivatives (canonical references are never downscaled)
REFERENCE_MAX_WIDTH=192
REFERENCE_MAX_HEIGHT=288
# Flat-rate image providers (billed per image, no input billing) get larger reference derivatives
FLAT_RATE_REFERENCE_MAX_WIDTH=768
FLAT_RATE_REFERENCE_MAX_HEIGHT=1152
REFERENCE_FIT=inside
REFERENCE_ALLOW_UPSCALE=false

# --- Provider batches (half price, up to 24h) ---------------------------------
# Image and text generation can be sent to a provider's batch API instead of running now: 50% cheaper, results
# within 24h. Opt in per run (`batch: true` on a generation request). Only OpenAI and Google keys have a batch
# API; DeepSeek discounts by time of day instead (peak is 01:00-04:00 and 06:00-10:00 UTC, Mon-Fri), and
# Meta/OpenRouter have none — a run on those keys falls back to generating normally.
# Your OpenAI batch queue limit, in input tokens per model (the Platform settings page shows it). Batches are
# chunked to stay 20% under this; a batch over the limit is rejected whole.
OPENAI_BATCH_MAX_ENQUEUED_TOKENS=1000000
# How often submitted batches are polled. They target 24h, so seconds gain nothing.
BATCH_POLL_INTERVAL_SECONDS=300

# --- MCP (AI agents: ChatGPT and other MCP clients) ----------------------------
# The endpoint is <your origin>/mcp. Everything is derived from API_PUBLIC_URL; see docs/MCP.md.
MCP_ENABLED=true
# Only when agents reach the server under another URL than API_PUBLIC_URL's origin (e.g. a separate tunnel host).
# MCP_PUBLIC_URL=https://mcp.example.com/mcp
# MCP_AUTH_ISSUER=https://mcp.example.com
# Extra Host names /mcp answers on (comma-separated); the public URLs' hosts and localhost are always allowed.
# MCP_ALLOWED_HOSTS=
# Key for MCP token fingerprints (openssl rand -hex 32). Empty: derived from SESSION_SECRET with its own label.
# Changing it (or SESSION_SECRET while this is empty) signs every agent out.
# MCP_TOKEN_SECRET=
MCP_ACCESS_TOKEN_TTL_MINUTES=15
MCP_REFRESH_TOKEN_TTL_DAYS=30
MCP_AUTH_CODE_TTL_SECONDS=300
# How long an agent's request waits for your approval before it expires.
MCP_APPROVAL_TTL_MINUTES=1440
# A change touching more panels than this is treated as sensitive (needs approval under "Ask me first").
MCP_BULK_APPROVAL_THRESHOLD=25
MCP_RATE_LIMIT_PER_MINUTE=240
# Development only: let an OAuth client id (CIMD) URL resolve to a private address.
MCP_CIMD_ALLOW_PRIVATE=false

# --- Project import -----------------------------------------------------------
# Packages stream to disk, so these bound disk and time, not memory (~4.3 MB of package per panel).
# Raising the upload limit means raising client_max_body_size on /api/projects/import in deploy/nginx/default.conf.
IMPORT_MAX_UPLOAD_MB=4096
IMPORT_MAX_ENTRY_MB=512
# Uncompressed-to-compressed ceiling: real packages measure 1.0, a zip bomb is orders of magnitude past this.
IMPORT_MAX_COMPRESSION_RATIO=5

# --- Mock / testing -----------------------------------------------------------
# In-process fake providers, no keys needed. Refused when NODE_ENV=production unless AI_MOCK_ALLOW_IN_PRODUCTION=true.
AI_MOCK_MODE=false
AI_MOCK_ALLOW_IN_PRODUCTION=false
# Alternative that exercises the real provider code: enable compose profile "mock", set
# AI_ALLOW_PRIVATE_BASE_URLS=true (development only — it disables the check that keeps a custom endpoint off
# private addresses), then add a credential in Account -> AI providers with kind "openai_compatible" and base URL
# http://mock-ai:4010/v1 (any key value).
AI_ALLOW_PRIVATE_BASE_URLS=false

# --- Local TTS: Kokoro-82M -------------------------------------------------------
TTS_ENABLED=true
TTS_PROVIDER=kokoro
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_DEFAULT_SPEED=1.0

# --- Accounts ----------------------------------------------------------------
# Off by default: create the first user with `bun admin:create` (or INITIAL_ADMIN_* below), then open
# registration only if you want anyone with the URL to be able to sign up.
REGISTRATION_ENABLED=false
# Mock email mailbox: password-reset links when no SMTP is configured. Admin-only, and off unless you need it.
DEV_MAILBOX_ENABLED=false
# Publishes the route inventory and request schemas at /api/docs, unauthenticated.
API_DOCS_ENABLED=false
# Optional first admin created by the migrate/bootstrap container (no defaults in code)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Workers -------------------------------------------------------------------
# 24 in flight suits a provider that allows ~150 image requests/min at ~15 s each.
IMAGE_WORKER_CONCURRENCY=24
IMAGE_EDIT_WORKER_CONCURRENCY=6
TEXT_WORKER_CONCURRENCY=4
# Parallel TTS jobs; keep equal to KOKORO_WORKERS (Kokoro processes). KOKORO_WORKERS x KOKORO_THREADS <= CPU cores.
TTS_WORKER_CONCURRENCY=4
KOKORO_WORKERS=4
KOKORO_THREADS=2
# Video export: clips rendered/encoded in parallel
VIDEO_ENCODE_CONCURRENCY=4
# How long a job may go without touching its row before maintenance treats it as abandoned by a crashed worker.
# Measured from the last write, not from the start, and never applied to a job a worker still has in hand — so a
# multi-hour export that reports progress is safe. Raise it only if a single quiet stage can exceed this.
STALLED_JOB_TIMEOUT_MINUTES=120

# --- Cloudflare tunnel (profile "tunnel") ------------------------------------------
CLOUDFLARED_CONFIG=./deploy/cloudflared/config.yml
CLOUDFLARED_CREDENTIALS=/home/you/.cloudflared/<TUNNEL_ID>.json
CLOUDFLARED_UID=1000
CLOUDFLARED_PROTOCOL=http2
